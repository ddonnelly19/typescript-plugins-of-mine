{
  "compilerOptions": {
    "target": "ESNext",   
    "module": "commonjs", 
    "lib": ["ESNext"],  
    "outDir": "./dist", 
    "rootDir": ".",
    "strict": true,  
    "strictNullChecks": false,   
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts", "spec/**/*.ts", "tests/**/*.ts"
  ]
}